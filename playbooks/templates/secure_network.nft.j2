# {{ ansible_managed }}
# Default-deny host firewall for {{ inventory_hostname }} ({{ secure_host_groups | join(', ') }}).
# Generated by confluent.platform.secure_network - edit the inventory, not this file.
{% macro peer_ips(group_list) -%}
{%- set ips = [] -%}
{%- for g in group_list -%}
{%- for h in groups.get(g, []) -%}
{%- set _ = ips.append(hostvars[h].ansible_default_ipv4.address) -%}
{%- endfor -%}
{%- endfor -%}
{{ ips | unique | sort | join(', ') }}
{%- endmacro %}
{% set drop_action = 'drop' if secure_network_enforce | bool else 'accept' %}

table inet cp_secure
delete table inet cp_secure

table inet cp_secure {
  chain input {
    type filter hook input priority 0; policy {{ 'drop' if secure_network_enforce | bool else 'accept' }};
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { 1, 58 } accept comment "icmp, icmpv6 (numeric: names need /etc/protocols)"

    # Administration: SSH only from the control node / bastion.
    ip saddr { {{ secure_network_admin_cidrs | join(', ') }} } tcp dport 22 accept comment "ssh-admin"

{% for f in secure_network_flows if f.dst in secure_host_groups %}
{% set src_ips = peer_ips(f.from | default([])) | trim %}
{% set src_all = ([src_ips] if src_ips | length > 0 else []) + (f.cidrs | default([])) %}
{% if src_all | length > 0 %}
    ip saddr { {{ src_all | join(', ') }} } tcp dport { {{ f.ports | map('int') | join(', ') }} } accept comment "{{ f.name }}"
{% endif %}
{% endfor %}
{% for r in secure_network_extra_ingress %}
    ip saddr { {{ r.from | join(', ') }} } {{ r.proto | default('tcp') }} dport { {{ r.ports | join(', ') }} } accept comment "{{ r.name | default('extra-ingress') }}"
{% endfor %}
{% if secure_network_log_drops | bool %}
    limit rate 10/minute log prefix "cp-secure-drop-in: "
{% endif %}
  }

  chain output {
    type filter hook output priority 0; policy {{ 'drop' if secure_network_enforce | bool else 'accept' }};
    oifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { 1, 58 } accept comment "icmp, icmpv6 (numeric: names need /etc/protocols)"

    # Name resolution and time.
{% if secure_network_dns_servers | length > 0 %}
    ip daddr { {{ secure_network_dns_servers | join(', ') }} } meta l4proto { tcp, udp } th dport 53 accept comment "dns"
{% else %}
    meta l4proto { tcp, udp } th dport 53 accept comment "dns"
{% endif %}
{% if secure_network_ntp_servers | length > 0 %}
    ip daddr { {{ secure_network_ntp_servers | join(', ') }} } udp dport 123 accept comment "ntp"
{% else %}
    udp dport 123 accept comment "ntp"
{% endif %}

    # Egress is the inverse of the flow matrix: only to the hosts/ports this group is allowed to reach.
{% for f in secure_network_flows if (f.from | default([])) | intersect(secure_host_groups) | length > 0 %}
{% set dst_ips = peer_ips([f.dst]) | trim %}
{% if dst_ips | length > 0 %}
    ip daddr { {{ dst_ips }} } tcp dport { {{ f.ports | map('int') | join(', ') }} } accept comment "{{ f.name }}"
{% endif %}
{% endfor %}
{% if secure_host_groups | intersect(['kafka_broker', 'kafka_controller']) | length > 0 and secure_network_ldap_hosts | length > 0 %}
    ip daddr { {{ secure_network_ldap_hosts | join(', ') }} } tcp dport { {{ secure_network_ldap_ports | join(', ') }} } accept comment "ldap"
{% endif %}
{% if secure_network_allow_package_egress | bool %}
    tcp dport { 80, 443 } accept comment "package-egress (deploy window only)"
{% endif %}
{% for r in secure_network_extra_egress %}
    ip daddr { {{ r.to | join(', ') }} } {{ r.proto | default('tcp') }} dport { {{ r.ports | join(', ') }} } accept comment "{{ r.name | default('extra-egress') }}"
{% endfor %}
{% if secure_network_log_drops | bool %}
    limit rate 10/minute log prefix "cp-secure-drop-out: "
{% endif %}
  }
}
