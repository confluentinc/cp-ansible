# {{ ansible_managed }}
# Default-deny host firewall for {{ inventory_hostname }} ({{ secure_host_groups | join(', ') }}).
# Generated by confluent.platform.secure_network - edit the inventory, not this file.
{% set enforce = secure_network_enforce | bool %}

table inet cp_secure
delete table inet cp_secure

table inet cp_secure {
  chain input {
    type filter hook input priority 0; policy {{ 'drop' if enforce else 'accept' }};
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { 1, 58 } accept comment "icmp, icmpv6 (numeric: names need /etc/protocols)"

    # Administration: SSH (this host's configured port) only from the control node / bastion.
    ip saddr { {{ secure_network_admin_cidrs | join(', ') }} } tcp dport {{ ansible_port | default(ansible_ssh_port | default(22)) }} accept comment "ssh-admin"

    # Ingress: this host's own listening ports (from its own variables), from the allowed sources.
{% for f in secure_network_resolved_flows if f.dst in secure_host_groups %}
{% for ep in f.endpoints if ep.host == inventory_hostname and ep.ports | length > 0 %}
{% set src_all = ([f.src_ips | join(', ')] if f.src_ips | length > 0 else []) + f.cidrs %}
{% if src_all | length > 0 %}
    ip saddr { {{ src_all | join(', ') }} } tcp dport { {{ ep.ports | join(', ') }} } accept comment "{{ f.name }}"
{% endif %}
{% endfor %}
{% endfor %}
{% for r in secure_network_extra_ingress %}
    ip saddr { {{ r.from | join(', ') }} } {{ r.proto | default('tcp') }} dport { {{ r.ports | join(', ') }} } accept comment "{{ r.name | default('extra-ingress') }}"
{% endfor %}
{% if secure_network_log_drops | bool %}
    limit rate 10/minute log prefix "cp-secure-drop-in: "
{% endif %}
  }

  chain output {
    type filter hook output priority 0; policy {{ 'drop' if enforce else 'accept' }};
    oifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { 1, 58 } accept comment "icmp, icmpv6 (numeric: names need /etc/protocols)"

    # Name resolution and time.
{% if secure_network_dns_servers | length > 0 %}
    ip daddr { {{ secure_network_dns_servers | join(', ') }} } meta l4proto { tcp, udp } th dport 53 accept comment "dns"
{% else %}
    meta l4proto { tcp, udp } th dport 53 accept comment "dns"
{% endif %}
{% if secure_network_ntp_servers | length > 0 %}
    ip daddr { {{ secure_network_ntp_servers | join(', ') }} } udp dport 123 accept comment "ntp"
{% else %}
    udp dport 123 accept comment "ntp"
{% endif %}

    # Egress is the inverse of the flow matrix: only to the hosts/ports this group is allowed to reach,
    # using each DESTINATION host's own port.
{% for f in secure_network_resolved_flows if f.from | intersect(secure_host_groups) | length > 0 %}
{% for ep in f.endpoints if ep.ports | length > 0 %}
    ip daddr {{ ep.ip }} tcp dport { {{ ep.ports | join(', ') }} } accept comment "{{ f.name }} -> {{ ep.host }}"
{% endfor %}
{% endfor %}
{% if secure_host_groups | intersect(['kafka_broker', 'kafka_controller']) | length > 0 and secure_network_ldap_hosts | length > 0 %}
    ip daddr { {{ secure_network_ldap_hosts | join(', ') }} } tcp dport { {{ secure_network_ldap_ports | join(', ') }} } accept comment "ldap"
{% endif %}
{% if 'kafka_broker' in secure_host_groups and audit_logs_destination_enabled | bool %}
    # Audit-log destination cluster: bootstrap addresses only. Clients then connect to every ADVERTISED
    # broker of that cluster, so list the rest in secure_network_extra_egress.
{% for entry in audit_logs_destination_bootstrap_servers.split(',') %}
{% set hp = entry | trim %}
    ip daddr {{ hp.rsplit(':', 1)[0] }} tcp dport {{ hp.rsplit(':', 1)[1] | default(9092) }} accept comment "audit-destination"
{% endfor %}
{% endif %}
{% if secure_network_allow_package_egress | bool %}
    tcp dport { 80, 443 } accept comment "package-egress (deploy window only)"
{% endif %}
{% for r in secure_network_extra_egress %}
    ip daddr { {{ r.to | join(', ') }} } {{ r.proto | default('tcp') }} dport { {{ r.ports | join(', ') }} } accept comment "{{ r.name | default('extra-egress') }}"
{% endfor %}
{% if secure_network_log_drops | bool %}
    limit rate 10/minute log prefix "cp-secure-drop-out: "
{% endif %}
  }
}
