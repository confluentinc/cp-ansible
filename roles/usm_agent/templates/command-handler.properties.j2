# {{ ansible_managed }}
#
# USM Agent Command Handler Configuration File
#

{% set final_properties = usm_agent_command_handler_final_properties %}
{% for property_name in final_properties %}
{{property_name}}={{final_properties[property_name]}}
{% endfor %}

# Managed Connect clusters, from usm_agent_command_handler_connect_clusters.
# Each cluster is keyed by its name; auth/tls lines are emitted only when set.
{% for c in usm_agent_command_handler_connect_clusters %}
confluent.usm-agent.command-handler.connect.clusters.{{ c.name }}.url={{ c.url }}
confluent.usm-agent.command-handler.connect.clusters.{{ c.name }}.group.id={{ c.group_id }}
{% if c.auth is defined and c.auth.type == 'basic' %}
confluent.usm-agent.command-handler.connect.clusters.{{ c.name }}.auth.type=basic
confluent.usm-agent.command-handler.connect.clusters.{{ c.name }}.auth.credential.file={{ usm_agent_secrets_dir }}/command-handler-{{ c.name }}-credential.txt
{% endif %}
{% if c.tls is defined %}
confluent.usm-agent.command-handler.connect.clusters.{{ c.name }}.tls.trusted.ca.file={{ usm_agent_secrets_dir }}/command-handler-{{ c.name }}-ca.crt
{% endif %}
{% endfor %}
