[Service]
# Redirect the Command Handler's stdout/stderr to a log file under the shared
# USM Agent log dir. The file name matches the usm-agent*.log glob in
# /etc/logrotate.d/usm-agent, so it is rotated by the same logrotate + cron as
# the agent -- no separate rotation config needed. The Command Handler writes
# all of its structured logs to stderr; stdout is redirected too for safety.
StandardOutput=append:{{ usm_agent.log_dir }}/usm-agent-command-handler.log
StandardError=append:{{ usm_agent.log_dir }}/usm-agent-command-handler.log
