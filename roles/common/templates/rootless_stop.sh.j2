#!/usr/bin/env bash
# {{ ansible_managed }}
# Stops {{ rootless_component_name }} started by its companion start script.
set -euo pipefail

BASE="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="${BASE}/{{ rootless_component_name }}.pid"

if [ ! -f "${PID_FILE}" ]; then
  echo "{{ rootless_component_name }}: no pid file at ${PID_FILE}, nothing to stop"
  exit 0
fi

PID="$(cat "${PID_FILE}")"
if kill -0 "${PID}" 2>/dev/null; then
  kill "${PID}"
  echo "Stopped {{ rootless_component_name }} (pid ${PID})"
else
  echo "{{ rootless_component_name }}: pid ${PID} not running"
fi
rm -f "${PID_FILE}"
